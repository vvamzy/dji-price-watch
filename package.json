{
  "name": "dji-price-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Track price drops on DJI Osmo Action 4 and Osmo Nano (India) and report them by Gmail.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --check",
    "dry": "node src/index.js --dry-run --force",
    "test": "node --test"
  },
  "dependencies": {
    "nodemailer": "^7.0.0"
  }
}
